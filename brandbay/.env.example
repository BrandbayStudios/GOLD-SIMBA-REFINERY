# Copy to .env (or set these in your hosting panel). Only SESSION_SECRET is required in production.
NODE_ENV=production
PORT=3000
BASE_URL=https://brandbaystudios.online
SESSION_SECRET=change-me-to-a-long-random-string

# First admin account, created automatically on first start if no admin exists.
ADMIN_EMAIL=info@brandbaystudio.online
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=BrandBay Admin

# Where data lives (keep this on persistent storage and back it up).
# DATABASE_PATH=./data/brandbay.db
# UPLOAD_DIR=./data/uploads
# PRIVATE_UPLOAD_DIR=./data/private

# Email notifications (new requests, orders, messages, password resets).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=info@brandbaystudio.online
SMTP_PASS=
MAIL_FROM=BrandBay Innovation Studios <info@brandbaystudio.online>
NOTIFY_EMAIL=info@brandbaystudio.online

# Optional
# CURRENCY=K
# DEPOSIT_PERCENT=70
# MAX_UPLOAD_MB=10
