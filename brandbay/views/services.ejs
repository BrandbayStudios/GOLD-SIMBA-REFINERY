<%- include('partials/head') %>

<section class="bg-section section-pad page-top">
  <%- include('partials/bg', { video: 'services', overlay: 81, eager: true }) %>
  <div class="container center narrow-text">
    <h1 class="page-title" data-split>Our services</h1>
    <p class="lead-light" data-reveal="fade-up">Your business deserves more than just design — it deserves strategy, innovation, and results.</p>
    <p class="lead-light small" data-reveal="fade-up">At <strong>BrandBay Innovation Studios</strong>, we provide complete solutions to help businesses build strong brands, establish a professional presence, and grow in the digital space.</p>
  </div>
  <div class="container service-cards" data-reveal-group>
    <% for (const service of services) { %><%- include('partials/service-tile', { service }) %><% } %>
  </div>
</section>

<%- include('partials/get-in-touch', { video: 'touch', overlay: 65 }) %>
<%- include('partials/foot') %>
