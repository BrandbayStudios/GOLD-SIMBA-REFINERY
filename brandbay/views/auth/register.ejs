<%- include('../partials/head') %>
<section class="section auth">
  <form class="card form auth-card" method="post" action="/register">
    <h1>Create your account</h1>
    <p class="muted">Use the email you applied with and your existing requests will appear on your dashboard.</p>
    <%- include('../partials/errors') %>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="next" value="<%= next %>">
    <label>Full name*<input name="name" required autocomplete="name" value="<%= form.name || '' %>"></label>
    <label>Email*<input type="email" name="email" required autocomplete="email" value="<%= form.email || '' %>"></label>
    <div class="form-row">
      <label>Phone<input type="tel" name="phone" autocomplete="tel" value="<%= form.phone || '' %>"></label>
      <label>Business<input name="company" autocomplete="organization" value="<%= form.company || '' %>"></label>
    </div>
    <div class="form-row">
      <label>Password*<input type="password" name="password" required minlength="8" autocomplete="new-password"></label>
      <label>Confirm password*<input type="password" name="password_confirm" required minlength="8" autocomplete="new-password"></label>
    </div>
    <button class="btn btn-gold btn-block" type="submit">Create account</button>
    <p class="form-note">Already have an account? <a href="/login">Sign in</a></p>
  </form>
</section>
<%- include('../partials/foot') %>
