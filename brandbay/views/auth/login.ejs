<%- include('../partials/head') %>
<section class="section auth">
  <form class="card form auth-card" method="post" action="/login">
    <h1>Sign in</h1>
    <p class="muted">Track your requests, quotes and orders.</p>
    <%- include('../partials/errors') %>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="next" value="<%= next %>">
    <label>Email<input type="email" name="email" required autocomplete="email" value="<%= form.email || '' %>" autofocus></label>
    <label>Password<input type="password" name="password" required autocomplete="current-password"></label>
    <button class="btn btn-gold btn-block" type="submit">Sign in</button>
    <p class="form-note"><a href="/forgot-password">Forgot your password?</a></p>
    <p class="form-note">New to BrandBay? <a href="/register<%= next ? '?next=' + encodeURIComponent(next) : '' %>">Create an account</a></p>
  </form>
</section>
<%- include('../partials/foot') %>
