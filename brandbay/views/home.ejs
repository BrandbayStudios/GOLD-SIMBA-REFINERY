<%- include('partials/head') %>

<section class="bg-section hero-video" id="top">
  <%- include('partials/bg', { video: 'hero', overlay: 52, eager: true }) %>
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container hero-center">
    <p class="hero-kicker" data-reveal="fade-down">BrandBay Innovation Studios <span>·</span> Lusaka, Zambia</p>
    <h1 class="hero-title" data-split>
      Where <span class="text-gold shimmer">Bold Brands</span> Are Engineered to Win.
    </h1>
    <p class="pill" data-reveal="zoom"><%= settings.tagline || 'Brand | Build | Boost' %></p>
    <p class="hero-text" data-reveal="fade-up"><%= settings.hero_text %></p>
    <div class="hero-buttons" data-reveal="fade-up">
      <a class="btn btn-white btn-lg btn-shine" href="/apply">Apply For Service</a>
      <a class="btn btn-gold btn-lg btn-shine" href="/about">Learn more</a>
    </div>
  </div>
  <a class="scroll-cue" href="#what-is" aria-label="Scroll down"><span></span></a>
</section>

<div class="gold-band" aria-hidden="true">
  <div class="gold-band-track">
    <% for (const pass of [0, 1]) { for (const s of services) { for (const item of lib.lines(s.items).slice(0, 3)) { %>
      <span><%= item %></span><span class="dot">✦</span>
    <% } } } %>
  </div>
</div>

<section class="bg-section section-pad" id="what-is">
  <%- include('partials/bg', { image: 'bg-laptop-desk', overlay: 82 }) %>
  <div class="container center narrow-text">
    <h2 class="section-title" data-reveal="fade-up">What is Brandbay Studio?</h2>
    <p class="lead-light" data-reveal="fade-up">BrandBay Innovation Studios is a multidisciplinary creative and technology firm in Lusaka, Zambia, focused on building market-leading brands. We don’t just design visuals, we build structured brand ecosystems engineered for authority, visibility, and revenue growth.</p>
  </div>
  <div class="container pillar-row" data-reveal-group>
    <% for (const [icon, label] of [['bulb', 'Strategic Thinking'], ['pen', 'High-Level Creative Execution'], ['code', 'Digital Infrastructure'], ['megaphone', 'Performance-Driven Marketing']]) { %>
      <div class="pillar-card tilt" data-reveal="zoom">
        <div class="pillar-card-icon"><%- include('partials/icon', { name: icon }) %></div>
        <h3><%= label %></h3>
      </div>
    <% } %>
  </div>
</section>

<section class="bg-section section-pad" id="services">
  <%- include('partials/bg', { image: 'bg-services', overlay: 60 }) %>
  <div class="container center narrow-text">
    <h2 class="section-title" data-reveal="fade-up">Our services</h2>
    <p class="lead-light" data-reveal="fade-up">Your business deserves more than just design — it deserves strategy, innovation, and results.</p>
    <p class="lead-light small" data-reveal="fade-up">At <strong>BrandBay Innovation Studios</strong>, we provide complete solutions to help businesses build strong brands, establish a professional presence, and grow in the digital space.</p>
  </div>
  <div class="container service-cards" data-reveal-group>
    <% for (const service of services) { %><%- include('partials/service-tile', { service }) %><% } %>
  </div>
</section>

<% if (logos.length) { %>
<section class="section-pad section-ink" id="work">
  <div class="container center narrow-text">
    <h2 class="section-title" data-reveal="fade-up">Glimpse of our work</h2>
    <p class="lead-light" data-reveal="fade-up">Behind every great brand is a powerful identity.<br>Here’s a glimpse of some of the logos we’ve crafted to help businesses stand out, build trust, and leave lasting impressions.</p>
  </div>
  <div class="logo-marquee" aria-hidden="true">
    <div class="logo-marquee-track">
      <% for (const pass of [0, 1]) { for (const logo of logos.slice(0, 12)) { %><img src="<%= logo.image %>" alt="" loading="lazy"><% } } %>
    </div>
  </div>
  <div class="container logo-wall" data-reveal-group data-lightbox-group>
    <% for (const logo of logos) { %>
      <button class="logo-tile" type="button" data-reveal="zoom" data-lightbox="<%= logo.image %>" data-caption="<%= logo.title %>">
        <img src="<%= logo.image %>" alt="<%= logo.title %> logo" loading="lazy">
        <span><%= logo.title %></span>
      </button>
    <% } %>
  </div>
  <div class="center"><a class="btn btn-outline btn-shine" href="/gallery" data-reveal="fade-up">View our full logofolio</a></div>
</section>
<% } %>

<section class="section-pad section-ink section-ink-2" id="testimonials">
  <div class="container center narrow-text">
    <h2 class="section-title" data-reveal="fade-up">TESTIMONIALS</h2>
    <p class="lead-light" data-reveal="fade-up">At <strong>BrandBay Innovation Studios</strong>, client satisfaction is at the center of everything we do. Our work is built on trust, professionalism, and delivering results that make a difference.</p>
  </div>
  <div class="container quote-grid" data-reveal-group>
    <% for (const t of testimonials) { %>
      <figure class="quote-card tilt" data-reveal="fade-up">
        <div class="stars" aria-label="<%= t.rating %> out of 5 stars"><%= '★'.repeat(Math.max(0, Math.min(5, t.rating))) %></div>
        <blockquote><%= t.quote %></blockquote>
        <figcaption><%= t.name %><% if (t.role) { %><span><%= t.role %></span><% } %></figcaption>
      </figure>
    <% } %>
  </div>

  <div class="container cta-split" id="trabajar-juntos">
    <div data-reveal="slide-right">
      <h2 class="cta-title">Your Brand Deserves More Than Average.</h2>
      <p class="lead-light">Partner with <span class="text-gold">BrandBay Innovation Studios</span> and build with clarity, precision, and innovation.</p>
      <p class="cta-strap">Start Today. Scale Tomorrow. Stay Ahead</p>
    </div>
    <form class="glass-form" method="post" action="/apply" data-reveal="slide-left">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off"></label></div>
      <label>Full Names<input name="name" required autocomplete="name" value="<%= currentUser ? currentUser.name : '' %>"></label>
      <label>Your Email*<input type="email" name="email" required autocomplete="email" value="<%= currentUser ? currentUser.email : '' %>"></label>
      <label>Service Applied For*
        <select name="service" required>
          <option value="">Choose a service</option>
          <% for (const s of services) { %><option><%= s.name %></option><% } %>
        </select>
      </label>
      <button class="btn btn-gold btn-block btn-shine" type="submit">Submit</button>
    </form>
  </div>
</section>

<%- include('partials/lightbox') %>
<%- include('partials/foot') %>
