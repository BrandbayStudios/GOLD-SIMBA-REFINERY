<%- include('partials/head') %>
<section class="page-hero compact">
  <div class="container">
    <a class="crumb" href="/projects">← All projects</a>
    <% if (project.category) { %><span class="eyebrow"><%= project.category %></span><% } %>
    <h1><%= project.title %></h1>
    <% if (project.summary) { %><p class="lead"><%= project.summary %></p><% } %>
    <% if (project.client) { %><p class="muted">Client: <%= project.client %></p><% } %>
    <% const tags = String(project.tags || '').split(',').map((t) => t.trim()).filter(Boolean); if (tags.length) { %>
      <ul class="project-tags"><% for (const t of tags) { %><li><%- include('partials/icon', { name: 'check' }) %><%= t %></li><% } %></ul>
    <% } %>
    <% if (project.website_url) { %>
      <a class="btn btn-gold btn-shine project-live" href="<%= project.website_url %>" target="_blank" rel="noopener">Visit live site <%- include('partials/icon', { name: 'arrow' }) %><span class="sr-only"> (opens <%= project.website_url.replace(/^https?:\/\//, '').replace(/\/$/, '') %> in a new tab)</span></a>
    <% } %>
  </div>
</section>
<section class="section">
  <div class="container">
    <div class="project-images" data-lightbox-group>
      <% for (const img of [project.image, project.image_2].filter(Boolean)) { %>
        <button class="project-image" type="button" data-lightbox="<%= img %>" data-caption="<%= project.title %>">
          <img src="<%= img %>" alt="<%= project.title %>">
        </button>
      <% } %>
    </div>
    <% const pages = lib.lines(project.gallery); %>
    <% if (pages.length) { %>
      <% const isWeb = project.category === 'Website Design'; const isPages = project.category === 'Company Profile'; %>
      <h2 class="project-pages-title"><%= isPages ? 'Inside the profile' : isWeb ? 'Screens from the site' : 'Photos from the job' %></h2>
      <div class="project-pages<%= isWeb ? ' is-screens' : isPages ? '' : ' is-photos' %>" data-lightbox-group data-reveal-group>
        <% pages.forEach((img, i) => { %>
          <button class="project-page" type="button" data-lightbox="<%= img %>" data-caption="<%= project.title %> — page <%= i + 1 %>" data-reveal="fade-up">
            <img src="<%= lib.thumb(img) %>" alt="<%= project.title %>, page <%= i + 1 %>" loading="lazy">
          </button>
        <% }) %>
      </div>
    <% } %>
    <% if (project.body) { %>
      <div class="prose">
        <% for (const p of lib.paragraphs(project.body)) { %><p><%= p %></p><% } %>
      </div>
    <% } %>
    <div class="cta-inline">
      <p><%= project.category === 'Website Design' ? 'Want a website like this for your business?' : 'Want something like this for your brand?' %></p>
      <a class="btn btn-gold" href="<%= project.category === 'Website Design' ? '/packages' : '/apply' %>"><%= project.category === 'Website Design' ? 'See website packages' : 'Start your project' %></a>
    </div>
  </div>
</section>
<% if (related.length) { %>
<section class="section section-paper">
  <div class="container">
    <h2>More projects</h2>
    <div class="project-grid three">
      <% for (const p of related) { %><%- include('partials/project-card', { project: p }) %><% } %>
    </div>
  </div>
</section>
<% } %>
<%- include('partials/lightbox') %>
<%- include('partials/foot') %>
