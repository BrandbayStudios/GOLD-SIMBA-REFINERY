<%- include('partials/head') %>

<section class="bg-section section-pad page-top">
  <%- include('partials/bg', { image: 'bg-about', overlay: 83, eager: true }) %>
  <div class="container about-intro">
    <div>
      <h1 class="page-title" data-split>About Brandbay <span class="text-gold">Innovation Studios</span></h1>
      <p class="lead-light" data-reveal="fade-up">At BrandBay Studio, we merge expertise in branding and technology to craft bespoke solutions that elevate brands to new heights. With a passion for innovation and a commitment to excellence, we empower our clients to stand out in the digital landscape. Join us in shaping the future of branding and technology.</p>
      <p class="lead-light" data-reveal="fade-up">Our platform connects entrepreneurs and companies with top-tier designs, revolutionizing the branding experience. Whether you're a startup in need of a striking logo or an established company seeking fresh marketing materials, we're here to transform your vision into unforgettable brand success.</p>
      <a class="btn btn-gold btn-lg btn-shine" href="/contact" data-reveal="fade-up">Get In Touch With Us Today</a>
    </div>
    <div class="about-badge" data-reveal="zoom" aria-hidden="true">
      <img src="/brand/logo-stacked-gold.png" alt="" width="954" height="565">
    </div>
  </div>
</section>

<div class="gold-strip" aria-hidden="true"></div>

<section class="bg-section section-pad">
  <%- include('partials/bg', { image: 'bg-about', overlay: 83 }) %>
  <div class="container center narrow-text">
    <h2 class="section-title" data-reveal="fade-up">Why Choose Us?</h2>
    <p class="lead-light" data-reveal="fade-up">Choose Brandbay Innovation Studio as your personal branding partner and let our passionate team of designers and strategists help you stand out from the crowd. Whether you're an individual entrepreneur with a big idea or a creative professional seeking to establish your personal brand, we offer personalized solutions tailored to your unique vision and goals. From captivating logo design to comprehensive branding strategies, we're committed to delivering exceptional results that reflect your personality and resonate with your target audience. Let us bring your brand to life in meaningful and memorable ways.</p>
  </div>
  <div class="container duo-cards" data-reveal-group>
    <div class="glass-card tilt" data-reveal="slide-right">
      <div class="stars">★★★★★</div>
      <h3>Individual Branding</h3>
      <p>Choose Brandbay Innovation Studio for personalized personal branding solutions that help you stand out. With a strategic approach tailored to your goals, we deliver exceptional results that resonate with your audience and make a lasting impression.</p>
    </div>
    <div class="glass-card tilt" data-reveal="slide-left">
      <div class="stars">★★★★★</div>
      <h3 class="text-gold">Corporate Branding</h3>
      <p>Corporate branding expertise that elevates your brand to new heights. Trust us to bring your brand vision to life, whether you're an individual entrepreneur or a corporation seeking to enhance your brand image.</p>
    </div>
  </div>
</section>

<section class="section-pad section-ink">
  <div class="container center">
    <h2 class="section-title" data-reveal="fade-up">Why Choose Us?</h2>
  </div>
  <div class="container icon-columns" data-reveal-group>
    <% for (const [icon, title, text] of [
      ['bulb', 'INNOVATION', 'We remain at the forefront of industry trends, incorporating latest tools to create ground breaking solutions'],
      ['gear', 'Proven Track Record', 'We believe in customer satisfaction and our portfolio proves that with the number of successful projects completed'],
      ['star', 'Creative Excellence', 'Highly skilled and creative Designers, developers, marketing experts that are passionate about growing your brand.'],
    ]) { %>
      <div class="icon-column" data-reveal="fade-up">
        <div class="icon-orb"><%- include('partials/icon', { name: icon }) %></div>
        <h3><%= title %></h3>
        <p><%= text %></p>
      </div>
    <% } %>
  </div>
</section>

<% if (certificates.length) { %>
<section class="bg-section section-pad section-light">
  <%- include('partials/bg', { image: 'bg-compliance', overlay: 0 }) %>
  <div class="container center">
    <h2 class="section-title dark" data-reveal="fade-up">Compliance</h2>
  </div>
  <div class="container cert-row" data-reveal-group data-lightbox-group>
    <% for (const c of certificates) { %>
      <button class="cert-card" type="button" data-reveal="flip" data-lightbox="<%= c.image %>" data-caption="<%= c.title %>">
        <img src="<%= c.image %>" alt="<%= c.title %>" loading="lazy">
        <span><%= c.title %></span>
      </button>
    <% } %>
  </div>
  <div class="center"><a class="btn btn-dark btn-shine" href="/terms" data-reveal="fade-up">VIEW OUR T's &amp; C's</a></div>
</section>
<% } %>

<%- include('partials/lightbox') %>
<%- include('partials/foot') %>
