<%
  const siteName = settings.site_name || 'BrandBay Innovation Studios';
  // Short brand suffix keeps titles near the ~60 characters search results show.
  const pageTitle = locals.fullTitle || (title ? `${title} | BrandBay` : 'Branding & Web Design Agency in Lusaka, Zambia | BrandBay');
  const fullDescription = (description || settings.hero_text || '').replace(/\s+/g, ' ').trim();
  const pageDescription = fullDescription.length <= 160 ? fullDescription : `${fullDescription.slice(0, 157).replace(/[\s,;:.]+\S*$/, '')}…`;
  const canonical = config.baseUrl + (path === '/' ? '/' : path.replace(/\/$/, ''));
  const shareImage = locals.ogImage ? seo.abs(locals.ogImage) : `${config.baseUrl}/brand/og-image.jpg`;
  // Same menu as the original site: Projects opens a sub-menu with Gallery.
  const nav = [
    ['/', 'Home'], ['/about', 'About'], ['/services', 'Services'],
    ['/projects', 'Projects', [['/projects', 'Recent projects'], ['/gallery', 'Gallery']]],
    ['/contact', 'Contact'], ['/store', 'Store'],
  ];
  const isActive = (href, sub) => href === '/' ? path === '/'
    : path === href || path.startsWith(href + '/') || (sub || []).some(([h]) => path === h || path.startsWith(h + '/'));
%><!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDescription %>">
  <meta name="robots" content="<%= locals.noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1' %>">
  <% if (!locals.noindex) { %><link rel="canonical" href="<%= canonical %>"><% } %>
  <meta property="og:site_name" content="<%= siteName %>">
  <meta property="og:locale" content="en_GB">
  <meta property="og:type" content="<%= locals.ogType || 'website' %>">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= pageDescription %>">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:image" content="<%= shareImage %>">
  <meta property="og:image:alt" content="<%= locals.ogImage ? pageTitle : siteName + ' logo' %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= pageTitle %>">
  <meta name="twitter:description" content="<%= pageDescription %>">
  <meta name="twitter:image" content="<%= shareImage %>">
  <meta name="geo.region" content="ZM-09">
  <meta name="geo.placename" content="Lusaka">
  <% if (settings.google_site_verification) { %><meta name="google-site-verification" content="<%= settings.google_site_verification %>"><% } %>
  <% if (settings.bing_site_verification) { %><meta name="msvalidate.01" content="<%= settings.bing_site_verification %>"><% } %>
  <meta name="theme-color" content="#0b0f14">
  <%- include('icons') %>
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/site.css">
  <% if (path === '/') { %><link rel="preload" as="image" href="/media/video/hero.jpg"><% } %>
  <% if (locals.extraCss) { %><link rel="stylesheet" href="<%= extraCss %>"><% } %>
  <% if (!locals.noindex) { %><script type="application/ld+json"><%- seo.graph([seo.organization(settings, orgServices), seo.website(settings), ...(locals.schema || [])]) %></script><% } %>
</head>
<body class="<%= path === '/' ? 'is-home' : '' %>">
<a class="skip-link" href="#main">Skip to content</a>
<div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="/"><img src="/brand/logo-horizontal-gold.png" alt="<%= siteName %>" width="1231" height="223"></a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="sr-only">Menu</span><span class="bar"></span><span class="bar"></span><span class="bar"></span>
    </button>
    <nav id="site-nav" class="site-nav" data-nav>
      <ul>
        <% for (const [href, label, sub] of nav) { %>
          <li class="<%= sub ? 'has-sub' : '' %>">
            <a href="<%= href %>" class="<%= isActive(href, sub) ? 'active' : '' %>"<%- isActive(href, sub) ? ' aria-current="page"' : '' %>><%= label %><% if (sub) { %> <span class="caret" aria-hidden="true">▾</span><% } %></a>
            <% if (sub) { %>
              <ul class="sub-menu">
                <% for (const [h, l] of sub) { %><li><a href="<%= h %>"><%= l %></a></li><% } %>
              </ul>
            <% } %>
          </li>
        <% } %>
      </ul>
      <div class="nav-actions">
        <a class="icon-link" href="/cart" aria-label="Cart (<%= cartCount %> items)">
          <%- include('icon', { name: 'bag' }) %><% if (cartCount) { %><span class="badge"><%= cartCount %></span><% } %>
        </a>
        <% if (currentUser) { %>
          <a class="icon-link" href="<%= currentUser.role === 'client' ? '/account' : '/admin' %>" aria-label="My account"><%- include('icon', { name: 'user' }) %></a>
        <% } else { %>
          <a class="nav-signin" href="/login">Sign in</a>
        <% } %>
        <a class="btn btn-gold btn-sm btn-shine" href="/contact">Get In Touch</a>
      </div>
    </nav>
  </div>
</header>
<main id="main">
<% if (flash.length) { %>
  <div class="container flash-stack">
    <% for (const f of flash) { %>
      <div class="flash flash-<%= f.type %>" role="status"><%= f.message %></div>
    <% } %>
  </div>
<% } %>
