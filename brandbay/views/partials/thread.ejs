<section class="thread" id="messages">
  <h2>Messages</h2>
  <% if (!messages.length) { %>
    <p class="muted">No messages yet.</p>
  <% } %>
  <ol class="thread-list">
    <% for (const m of messages) { %>
      <li class="msg <%= m.from_staff ? 'msg-staff' : 'msg-client' %>">
        <div class="msg-meta"><strong><%= m.author_name %></strong><% if (m.from_staff) { %> <span class="tag">BrandBay</span><% } %> · <%= lib.formatDate(m.created_at, true) %></div>
        <%- include('text', { text: m.body }) %>
      </li>
    <% } %>
  </ol>
  <form class="form" method="post" action="<%= action %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label><span class="sr-only">Message</span><textarea name="body" rows="4" required placeholder="Write a message…"></textarea></label>
    <button class="btn btn-gold" type="submit">Send message</button>
  </form>
</section>
