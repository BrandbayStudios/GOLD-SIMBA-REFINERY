<article class="service-tile tilt" data-reveal="fade-up">
  <a class="service-tile-media" href="/services/<%= service.slug %>" tabindex="-1" aria-hidden="true">
    <img src="<%= lib.serviceImage(service.slug) %>" alt="" loading="lazy">
  </a>
  <div class="service-tile-body">
    <h3><a href="/services/<%= service.slug %>"><%= service.name %></a></h3>
    <% if (service.tagline) { %><p class="service-tile-tag"><%= service.tagline %></p><% } %>
    <ul>
      <% for (const item of lib.lines(service.items)) { %><li><%= item %></li><% } %>
    </ul>
    <% if (service.closing) { %><p class="service-tile-close"><%= service.closing %></p><% } %>
    <div class="service-tile-actions">
      <a class="link-arrow" href="/services/<%= service.slug %>">Learn more <%- include('icon', { name: 'arrow' }) %></a>
      <a class="btn btn-gold btn-sm btn-shine" href="/apply?service=<%= service.slug %>">Apply</a>
    </div>
  </div>
</article>
