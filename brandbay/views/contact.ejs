<%- include('partials/head') %>

<section class="bg-section section-pad page-top">
  <%- include('partials/bg', { video: 'faq', overlay: 53, eager: true }) %>
  <div class="container faq-split">
    <div data-reveal="slide-right">
      <h1 class="page-title text-gold left" data-split>Frequently asked questions</h1>
      <p class="lead-light">Everything you need to know about working with BrandBay — timelines, payment, files and changes.</p>
      <a class="btn btn-gold btn-shine" href="#get-in-touch">Ask us anything</a>
    </div>
    <div class="faq-list" data-reveal-group>
      <% faqs.forEach((f, i) => { %>
        <details class="faq-item" data-reveal="fade-up"<%= i === 0 ? ' open' : '' %>>
          <summary><%= f.question %></summary>
          <div class="faq-answer"><%- include('partials/text', { text: f.answer }) %></div>
        </details>
      <% }) %>
    </div>
  </div>
</section>

<%- include('partials/get-in-touch', { image: 'bg-contact', overlay: 90 }) %>

<section class="map-strip" aria-label="Map">
  <iframe class="map" title="Map of Cairo Road, Lusaka" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
    src="https://www.google.com/maps?q=<%= encodeURIComponent(settings.address_1 || 'Cairo Road, Lusaka, Zambia') %>&output=embed"></iframe>
</section>
<%- include('partials/foot') %>
