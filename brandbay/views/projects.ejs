<%- include('partials/head') %>

<section class="bg-section section-pad page-top">
  <%- include('partials/bg', { image: 'bg-footer-keyboard', overlay: 73, eager: true }) %>
  <div class="container center narrow-text">
    <h1 class="page-title text-gold" data-split>OUR RECENT PROJECTS</h1>
    <p class="lead-light" data-reveal="fade-up">Have a look at some of our recent branding, graphic design works</p>
  </div>
  <% if (categories.length > 1) { %>
    <div class="container filter-row center-row" role="group" aria-label="Filter projects" data-filter-group data-reveal="fade-up">
      <button class="chip chip-dark active" type="button" data-filter="">All</button>
      <% for (const c of categories) { %><button class="chip chip-dark" type="button" data-filter="<%= c %>"><%= c %></button><% } %>
    </div>
  <% } %>
  <% if (projects.length) { %>
    <div class="container mockup-grid" data-filter-target data-reveal-group>
      <% for (const p of projects) { %>
        <a class="mockup-card" href="/projects/<%= p.slug %>" data-category="<%= p.category || '' %>" data-reveal="zoom">
          <img src="<%= p.image %>" alt="<%= p.title %>" loading="lazy">
          <span class="mockup-info">
            <% if (p.category) { %><small><%= p.category %></small><% } %>
            <strong><%= p.title %></strong>
            <em>View project <%- include('partials/icon', { name: 'arrow' }) %></em>
          </span>
        </a>
      <% } %>
    </div>
  <% } else { %>
    <p class="center lead-light">New projects are coming soon.</p>
  <% } %>
</section>
<%- include('partials/foot') %>
