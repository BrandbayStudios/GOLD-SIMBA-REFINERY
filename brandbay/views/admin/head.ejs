<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= title %> · BrandBay Admin</title>
  <%- include('../partials/icons') %>
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/invoice.css">
</head>
<body class="admin">
<%
  const invoicingPages = ['/admin/invoices/catalog', '/admin/invoices/settings'];
  const navItem = (href, label, badge) => ({
    href, label, badge,
    active: href === '/admin' ? path === '/admin' || path === '/admin/'
      : href === '/admin/invoices' ? path.startsWith(href) && !invoicingPages.includes(path)
      : path.startsWith(href),
  });
  const groups = [
    ['Work', [navItem('/admin', 'Dashboard'), navItem('/admin/requests', 'Service requests', counts.newRequests), navItem('/admin/invoices', 'Invoices & quotes', counts.overdueInvoices), navItem('/admin/orders', 'Orders', counts.pendingOrders), navItem('/admin/messages', 'Messages', counts.unreadMessages), navItem('/admin/subscribers', 'Subscribers')]],
    ['Invoicing', [navItem('/admin/invoices/catalog', 'Service prices')].concat(currentUser.role === 'admin' ? [navItem('/admin/invoices/settings', 'Taxes, currency & banks')] : [])],
    ['Website', Object.entries(resources).map(([key, r]) => navItem(`/admin/content/${key}`, r.label))],
  ];
  if (currentUser.role === 'admin') groups.push(['Administration', [navItem('/admin/users', 'Users'), navItem('/admin/settings', 'Settings')]]);
%>
<div class="admin-shell">
  <aside class="admin-sidebar" data-nav>
    <a class="brand" href="/admin"><img src="/brand/logo-horizontal-gold.png" alt="BrandBay" width="1231" height="223"><small>Admin</small></a>
    <% for (const [label, items] of groups) { %>
      <p class="admin-group"><%= label %></p>
      <ul>
        <% for (const item of items) { %>
          <li><a href="<%= item.href %>" class="<%= item.active ? 'active' : '' %>"><%= item.label %><% if (item.badge) { %><span class="badge"><%= item.badge %></span><% } %></a></li>
        <% } %>
      </ul>
    <% } %>
    <div class="admin-sidebar-foot">
      <a href="/" target="_blank" rel="noopener">View website ↗</a>
      <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-btn" type="submit">Sign out (<%= currentUser.name.split(' ')[0] %>)</button></form>
    </div>
  </aside>
  <div class="admin-main">
    <header class="admin-topbar">
      <button class="nav-toggle" type="button" aria-expanded="false" data-nav-toggle><span class="sr-only">Menu</span><span class="bar"></span><span class="bar"></span><span class="bar"></span></button>
      <h1><%= title %></h1>
    </header>
    <main class="admin-content" id="main">
      <% for (const f of flash) { %><div class="flash flash-<%= f.type %>" role="status"><%= f.message %></div><% } %>
