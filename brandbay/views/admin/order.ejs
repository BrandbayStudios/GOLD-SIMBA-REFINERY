<%- include('head') %>
<a class="crumb" href="/admin/orders">← All orders</a>
<div class="admin-grid wide-left">
  <section class="panel">
    <h2><%= order.reference %></h2>
    <div class="table-wrap"><table class="table">
      <thead><tr><th>Item</th><th>Unit price</th><th>Qty</th><th class="num">Total</th></tr></thead>
      <tbody><% for (const i of items) { %><tr><td><%= i.name %></td><td><%= lib.money(i.unit_price) %></td><td><%= i.quantity %></td><td class="num"><%= lib.money(i.line_total) %></td></tr><% } %></tbody>
      <tfoot><tr><th colspan="3">Total</th><th class="num"><%= lib.money(order.subtotal) %></th></tr></tfoot>
    </table></div>
    <dl class="details">
      <dt>Customer</dt><dd><%= order.name %></dd>
      <dt>Email</dt><dd><a href="mailto:<%= order.email %>"><%= order.email %></a></dd>
      <dt>Phone</dt><dd><a href="tel:<%= order.phone %>"><%= order.phone %></a></dd>
      <dt>Delivery</dt><dd><%= order.delivery_method === 'delivery' ? `Deliver to: ${order.address}` : 'Collect from studio' %></dd>
      <dt>Payment method</dt><dd><%= lib.PAYMENT_METHODS[order.payment_method] %></dd>
      <dt>Placed</dt><dd><%= lib.formatDate(order.created_at, true) %></dd>
    </dl>
    <% if (order.notes) { %><h3>Notes</h3><%- include('../partials/text', { text: order.notes }) %><% } %>
  </section>
  <form class="panel form" method="post" action="/admin/orders/<%= order.id %>">
    <h2>Manage</h2>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Order status
      <select name="status"><% for (const [key, label] of Object.entries(lib.ORDER_STATUSES)) { %><option value="<%= key %>"<%= order.status === key ? ' selected' : '' %>><%= label %></option><% } %></select>
    </label>
    <label>Payment status
      <select name="payment_status"><% for (const [key, label] of Object.entries(lib.PAYMENT_STATUSES)) { %><option value="<%= key %>"<%= order.payment_status === key ? ' selected' : '' %>><%= label %></option><% } %></select>
    </label>
    <label class="check"><input type="checkbox" name="notify_client" value="1" checked> Email the customer about changes</label>
    <button class="btn btn-gold btn-block" type="submit">Save</button>
    <p class="muted">Cancelling an order returns its items to stock.</p>
  </form>
</div>
<%- include('foot') %>
