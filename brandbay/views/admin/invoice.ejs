<%- include('head') %>
<% const d = doc.inv, t = doc.t, m = (v) => inv.money(v, d.currency_symbol); %>
<a class="crumb" href="/admin/invoices">← All invoices &amp; quotes</a>
<div class="invoice-bar panel">
  <div class="invoice-bar-status">
    <%- include('../partials/status', { value: doc.status, labels: inv.STATUSES }) %>
    <% if (!['quotation', 'receipt'].includes(d.type)) { %><span>Balance <strong><%= m(Math.max(0, t.balance)) %></strong> of <%= m(t.payable) %></span><% } %>
    <% if (d.sent_at) { %><span class="muted">Sent <%= lib.formatDate(d.sent_at) %></span><% } %>
    <% if (request) { %><a href="/admin/requests/<%= request.id %>">Request <%= request.reference %></a><% } %>
    <% if (source) { %><a href="/admin/invoices/<%= source.id %>">From <%= source.number %></a><% } %>
    <% for (const r of related) { %><a href="/admin/invoices/<%= r.id %>">→ <%= r.number %></a><% } %>
  </div>
  <div class="form-actions">
    <a class="btn btn-outline-dark btn-sm" href="/admin/invoices/<%= d.id %>/edit">Edit</a>
    <a class="btn btn-gold btn-sm" href="<%= publicUrl %>?print=1" target="_blank" rel="noopener">Print / PDF</a>
    <form method="post" action="/admin/invoices/<%= d.id %>/send" data-confirm="Email this <%= doc.label.toLowerCase() %> to <%= d.client_email || 'the client' %>?">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-outline-dark btn-sm" type="submit">Email to client</button>
    </form>
    <% if (d.type === 'quotation' || d.type === 'proforma') { %>
      <form method="post" action="/admin/invoices/<%= d.id %>/convert"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="to" value="invoice"><button class="btn btn-gold btn-sm" type="submit">Convert to invoice</button></form>
    <% } %>
    <% if (d.type === 'quotation') { %>
      <form method="post" action="/admin/invoices/<%= d.id %>/convert"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="to" value="proforma"><button class="btn btn-outline-dark btn-sm" type="submit">Convert to proforma</button></form>
      <% for (const st of ['accepted', 'declined']) { if (d.status !== st) { %>
        <form method="post" action="/admin/invoices/<%= d.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="<%= st %>"><button class="btn btn-outline-dark btn-sm" type="submit">Mark <%= st %></button></form>
      <% } } %>
    <% } %>
    <% if (d.type === 'invoice' && doc.payments.length) { %>
      <form method="post" action="/admin/invoices/<%= d.id %>/receipt"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-dark btn-sm" type="submit">Issue receipt</button></form>
    <% } %>
    <form method="post" action="/admin/invoices/<%= d.id %>/duplicate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-dark btn-sm" type="submit">Duplicate</button></form>
    <% if (d.status !== 'cancelled' && d.type !== 'receipt') { %>
      <form method="post" action="/admin/invoices/<%= d.id %>/status" data-confirm="Cancel <%= d.number %>? It will show as VOID."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="cancelled"><button class="btn btn-outline-dark btn-sm" type="submit">Cancel</button></form>
    <% } %>
    <% if (currentUser.role === 'admin') { %>
      <form method="post" action="/admin/invoices/<%= d.id %>/delete" data-confirm="Permanently delete <%= d.number %> and its payments?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger btn-sm" type="submit">Delete</button></form>
    <% } %>
  </div>
</div>

<div class="admin-grid wide-left">
  <div class="paper-scroll"><%- include('../invoices/paper', { doc, invoicing: inv, is }) %></div>
  <div>
    <% if (d.type !== 'quotation') { %>
    <section class="panel">
      <h2>Payments</h2>
      <% if (!doc.payments.length) { %><p class="muted">No payments recorded yet.</p><% } %>
      <ul class="list">
        <% for (const p of doc.payments) { %>
          <li><span><strong><%= m(p.amount) %></strong> · <%= p.method %><br><small class="muted"><%= lib.formatDate(p.paid_on) %><%= p.reference ? ` · ${p.reference}` : '' %></small></span>
            <form method="post" action="/admin/invoices/<%= d.id %>/payments/<%= p.id %>/delete" data-confirm="Remove this payment?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-btn danger" type="submit">Remove</button></form></li>
        <% } %>
      </ul>
      <% if (d.type !== 'receipt' && d.status !== 'cancelled' && t.balance > 0) { %>
        <form class="form" method="post" action="/admin/invoices/<%= d.id %>/payments">
          <h3>Record a payment</h3>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-row">
            <label>Amount (<%= d.currency %>)<input type="number" name="amount" min="0.01" step="0.01" value="<%= inv.round2(t.balance) %>" required></label>
            <label>Date<input type="date" name="paid_on" value="<%= inv.today() %>" required></label>
          </div>
          <div class="form-row">
            <label>Method<select name="method"><% for (const pm of inv.PAYMENT_METHODS) { %><option><%= pm %></option><% } %></select></label>
            <label>Reference<input name="reference" placeholder="Transaction ID"></label>
          </div>
          <% if (d.deposit_percent > 0 && !t.paid) { %><p class="muted">Deposit (<%= d.deposit_percent %>%): <%= m(t.deposit) %></p><% } %>
          <button class="btn btn-gold" type="submit">Save payment</button>
        </form>
      <% } %>
    </section>
    <% } %>
    <section class="panel">
      <h2>Client link</h2>
      <p class="muted">Anyone with this link can view and download the document. <% if (d.user_id || d.client_email) { %>It also appears in the client’s dashboard once sent.<% } %></p>
      <input readonly value="<%= publicUrl %>" aria-label="Client link" data-select-on-focus>
    </section>
  </div>
</div>
<%- include('foot') %>
