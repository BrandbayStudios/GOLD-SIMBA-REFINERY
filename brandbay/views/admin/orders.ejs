<%- include('head') %>
<div class="filter-row">
  <a class="chip<%= !status ? ' active' : '' %>" href="/admin/orders">All</a>
  <% for (const [key, label] of Object.entries(lib.ORDER_STATUSES)) { %><a class="chip<%= status === key ? ' active' : '' %>" href="/admin/orders?status=<%= key %>"><%= label %></a><% } %>
</div>
<div class="panel table-wrap">
  <table class="table">
    <thead><tr><th>Reference</th><th>Customer</th><th>Placed</th><th>Status</th><th>Payment</th><th class="num">Total</th></tr></thead>
    <tbody>
      <% if (!orders.length) { %><tr><td colspan="6" class="muted">No orders yet.</td></tr><% } %>
      <% for (const o of orders) { %>
        <tr>
          <td><a href="/admin/orders/<%= o.id %>"><strong><%= o.reference %></strong></a></td>
          <td><%= o.name %><br><small class="muted"><%= o.phone %></small></td>
          <td><%= lib.formatDate(o.created_at) %></td>
          <td><%- include('../partials/status', { value: o.status, labels: lib.ORDER_STATUSES }) %></td>
          <td><%- include('../partials/status', { value: o.payment_status, labels: lib.PAYMENT_STATUSES }) %></td>
          <td class="num"><%= lib.money(o.subtotal) %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('pager', { query: { status } }) %>
<%- include('foot') %>
