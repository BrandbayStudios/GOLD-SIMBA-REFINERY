<%- include('head') %>
<% if (!mailEnabled) { %>
  <div class="flash flash-info">Email is not configured, so notifications are only written to the server log. Set the SMTP_* environment variables to send real emails (see README).</div>
<% } %>
<form class="panel form" method="post" action="/admin/settings">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% for (const f of fields) { %>
    <% if (f.heading) { %>
      <h2 class="settings-heading"><%= f.heading %></h2>
      <% if (f.note) { %><p class="muted"><%= f.note %></p><% } %>
    <% } else { %>
    <label><%= f.label %>
      <% if (f.type === 'textarea') { %><textarea name="<%= f.name %>" rows="<%= f.rows || 4 %>"><%= values[f.name] || '' %></textarea>
      <% } else if (f.type === 'select') { %><select name="<%= f.name %>"><% for (const [v, l] of f.options) { %><option value="<%= v %>"<%= (values[f.name] || f.options[0][0]) === v ? ' selected' : '' %>><%= l %></option><% } %></select>
      <% } else if (f.type === 'secret') { %><input type="password" name="<%= f.name %>" value="" autocomplete="off" placeholder="<%= values[f.name] ? 'Saved — leave blank to keep it' : '' %>">
      <% } else { %><input name="<%= f.name %>" value="<%= values[f.name] || '' %>"><% } %>
    </label>
    <% } %>
  <% } %>
  <button class="btn btn-gold" type="submit">Save settings</button>
</form>
<form class="panel form" method="post" action="/admin/settings/test-alert">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <h2>Test WhatsApp alert</h2>
  <p class="muted"><%= alertsReady ? 'Alerts are set up. Send yourself a test message to confirm it works.' : 'Alerts are not set up yet. Fill in the WhatsApp alert details above and save first.' %></p>
  <button class="btn btn-outline-dark" type="submit">Send a test alert</button>
</form>
<%- include('foot') %>
