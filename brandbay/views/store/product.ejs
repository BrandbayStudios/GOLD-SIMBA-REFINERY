<%- include('../partials/head') %>
<section class="section">
  <div class="container">
    <a class="crumb" href="/store">← Store</a>
    <div class="product-detail">
      <div class="product-media large">
        <% if (product.image) { %><img src="<%= product.image %>" alt="<%= product.name %>"><% } else { %><span class="product-placeholder"><%- include('../partials/icon', { name: 'printer' }) %></span><% } %>
      </div>
      <div>
        <% if (product.category) { %><span class="eyebrow"><%= product.category %></span><% } %>
        <h1><%= product.name %></h1>
        <p class="price large"><%= lib.money(product.price) %><% if (product.unit) { %> <small><%= product.unit %></small><% } %></p>
        <%- include('../partials/text', { text: product.description }) %>
        <% if (product.stock === 0) { %>
          <p class="flash flash-info">Out of stock — <a href="/contact">contact us</a> for availability.</p>
        <% } else { %>
          <form class="add-to-cart" method="post" action="/cart/add">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="product_id" value="<%= product.id %>">
            <label>Quantity<input type="number" name="qty" value="1" min="1" max="<%= product.stock ?? 999 %>"></label>
            <button class="btn btn-gold btn-lg" type="submit">Add to cart</button>
          </form>
          <% if (product.stock !== null) { %><p class="muted"><%= product.stock %> in stock</p><% } %>
        <% } %>
        <p class="muted">Need a custom size, finish or design? <a href="/apply?service=printing-artistry">Request a custom quote</a>.</p>
      </div>
    </div>
  </div>
</section>
<% if (related.length) { %>
<section class="section section-paper">
  <div class="container">
    <h2>You may also need</h2>
    <div class="product-grid">
      <% for (const p of related) { %>
        <a class="product-card" href="/store/<%= p.slug %>">
          <div class="product-media"><% if (p.image) { %><img src="<%= p.image %>" alt="" loading="lazy"><% } else { %><span class="product-placeholder"><%- include('../partials/icon', { name: 'printer' }) %></span><% } %></div>
          <div class="product-body"><h3><%= p.name %></h3><p class="price"><%= lib.money(p.price) %></p></div>
        </a>
      <% } %>
    </div>
  </div>
</section>
<% } %>
<%- include('../partials/foot') %>
