<%- include('../partials/head') %>
<section class="page-hero compact">
  <div class="container">
    <span class="eyebrow">Store</span>
    <h1>Print &amp; design, <em>ordered online</em>.</h1>
    <p class="lead">Order printing and ready-made design packages. Pay by Mobile Money, bank transfer or cash on collection.</p>
  </div>
</section>
<section class="section">
  <div class="container">
    <% if (categories.length > 1) { %>
      <div class="filter-row">
        <a class="chip<%= !category ? ' active' : '' %>" href="/store">All</a>
        <% for (const c of categories) { %><a class="chip<%= category === c ? ' active' : '' %>" href="/store?category=<%= encodeURIComponent(c) %>"><%= c %></a><% } %>
      </div>
    <% } %>
    <% if (products.length) { %>
      <div class="product-grid">
        <% for (const p of products) { %>
          <article class="product-card">
            <a class="product-media" href="/store/<%= p.slug %>">
              <% if (p.image) { %><img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy"><% } else { %><span class="product-placeholder"><%- include('../partials/icon', { name: p.category === 'Design' ? 'pen' : 'printer' }) %></span><% } %>
            </a>
            <div class="product-body">
              <% if (p.category) { %><span class="eyebrow"><%= p.category %></span><% } %>
              <h3><a href="/store/<%= p.slug %>"><%= p.name %></a></h3>
              <p class="price"><%= lib.money(p.price) %><% if (p.unit) { %> <small><%= p.unit %></small><% } %></p>
              <% if (p.stock === 0) { %>
                <p class="muted">Out of stock</p>
              <% } else { %>
                <form method="post" action="/cart/add">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="product_id" value="<%= p.id %>">
                  <button class="btn btn-gold btn-sm btn-block" type="submit">Add to cart</button>
                </form>
              <% } %>
            </div>
          </article>
        <% } %>
      </div>
    <% } else { %>
      <div class="empty card">
        <h2>Our online store is opening soon</h2>
        <p>In the meantime, request printing or design work directly and we’ll send you a quote.</p>
        <a class="btn btn-gold" href="/apply?service=printing-artistry">Request a printing quote</a>
      </div>
    <% } %>
  </div>
</section>
<%- include('../partials/foot') %>
