<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= doc.label %> <%= doc.inv.number %> · <%= settings.site_name %></title>
  <%- include('../partials/icons') %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Poppins:wght@300;400;500;600;700&display=swap">
  <link rel="stylesheet" href="/css/invoice.css">
</head>
<body class="print-page"<%- autoPrint ? ' data-autoprint' : '' %>>
  <div class="print-bar">
    <span><%= doc.label %> <strong><%= doc.inv.number %></strong> · <%= invoicing.STATUSES[doc.status] %></span>
    <button type="button" class="print-btn" data-print>Print / Save as PDF</button>
  </div>
  <div class="paper-scroll"><%- include('paper') %></div>
  <script src="/js/print.js" defer></script>
</body>
</html>
