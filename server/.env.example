# Copy this file to .env and fill in real values before deploying.
# Load it with: node --env-file=.env server.js  (Node 20.6+)

PORT=4000

# Staff sign-in credentials for the #admin dashboard.
# Defaults to admin / ADMINGSR2026 if unset — change these in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Secret used to sign staff bearer tokens. Use a long random string.
TOKEN_SECRET=change-me-too
