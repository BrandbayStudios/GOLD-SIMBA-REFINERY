APP_NAME="HANDY NOW"
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_URL=https://__DOMAIN__
APP_TIMEZONE=Africa/Lusaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Hostinger MySQL (hPanel → Databases → MySQL Databases). Host is always localhost.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=__DB_DATABASE__
DB_USERNAME=__DB_USERNAME__
DB_PASSWORD=__DB_PASSWORD__

SESSION_DRIVER=file
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# First administrator, created by the installer
ADMIN_EMAIL=__ADMIN_EMAIL__
ADMIN_PASSWORD=__ADMIN_PASSWORD__
ADMIN_PHONE=__ADMIN_PHONE__

# true = also load the purple-badged demo records (removable later in Admin → Settings)
SEED_DEMO_DATA=__SEED_DEMO__

# One-time installer: open https://__DOMAIN__/install?token=<this value>, then DELETE this line.
INSTALL_TOKEN=__INSTALL_TOKEN__

# SMS: log (nothing sent) | africastalking
SMS_DRIVER=log
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
